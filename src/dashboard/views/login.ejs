<!doctype html>
<html lang="fr" data-theme="<%= theme %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="login-token" content="<%= loginCsrf %>">
  <title>Connexion · ShopSphere Admin</title>
  <link rel="icon" href="/admin/assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/admin/assets/app.css">
  <script src="/admin/assets/vendor/webauthn.js" defer></script>
  <script src="/admin/assets/faceid.js" defer></script>
</head>
<body class="login-page">
  <main class="login">
    <section class="login-panel">
      <div class="brand">
        <span class="brand-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 8.5 12 4l8 4.5v7L12 20l-8-4.5z"/><path d="M12 12 4 8.5M12 12l8-3.5M12 12v8"/></svg></span>
        <span><b>ShopSphere</b><small>Administration</small></span>
      </div>

      <% if (step === 'code') { %>
        <h1>Vérification</h1>
        <p class="muted login-sub">Saisissez le code à 6 chiffres envoyé<% if (typeof sentTo !== 'undefined' && sentTo) { %> à <b><%= sentTo %></b><% } %>.</p>
        <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
        <form method="post" action="/admin/login/code" class="form">
          <input type="hidden" name="_csrf" value="<%= loginCsrf %>">
          <input type="hidden" name="next" value="<%= next %>">
          <label>Code de connexion
            <input class="code-input" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" placeholder="000000" required autofocus>
          </label>
          <button class="btn primary lg" type="submit">Valider</button>
        </form>
        <a class="login-back" href="/admin/login">Retour à la connexion</a>
      <% } else { %>
        <h1>Connexion</h1>
        <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
        <div class="alert error" role="alert" data-faceid-error hidden></div>

        <button class="btn faceid lg" type="button" data-faceid-login data-next="<%= next %>" hidden>
          <svg class="ic" viewBox="0 0 24 24"><path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2"/><path d="M9 9.5v1M15 9.5v1M12 9.5v3.5h-1M9.5 15.5c1.4 1.1 3.6 1.1 5 0"/></svg>
          Se connecter avec Face ID
        </button>
        <div class="divider" data-faceid-divider hidden><span>ou</span></div>

        <form method="post" action="/admin/login" class="form">
          <input type="hidden" name="_csrf" value="<%= loginCsrf %>">
          <input type="hidden" name="next" value="<%= next %>">
          <label>Adresse e-mail
            <input type="email" name="email" value="<%= email %>" autocomplete="username webauthn" required autofocus>
          </label>
          <label>Mot de passe
            <input type="password" name="password" autocomplete="current-password" required>
          </label>
          <% if (captcha) { %>
            <div class="captcha">
              <span class="captcha-label">Vérification</span>
              <div class="captcha-row">
                <img src="/admin/captcha.svg" alt="Code de vérification" width="180" height="66" data-captcha>
                <button class="btn ghost captcha-refresh" type="button" data-captcha-refresh title="Nouvelle image" aria-label="Nouvelle image">
                  <svg class="ic" viewBox="0 0 24 24"><path d="M19.5 12a7.5 7.5 0 1 1-2.2-5.3"/><path d="M19.5 4.5v4h-4"/></svg>
                </button>
              </div>
              <input name="captcha" aria-label="Recopiez les caractères de l'image" placeholder="Recopiez les caractères" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="8" required>
            </div>
          <% } %>
          <button class="btn primary lg" type="submit">Se connecter</button>
        </form>
      <% } %>
    </section>
  </main>
</body>
</html>
