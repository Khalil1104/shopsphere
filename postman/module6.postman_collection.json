      "item": [
        {
          "name": "POST inscription client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"nom\":\"Client test\",\"email\":\"{{clientEmail}}\",\"motDePasse\":\"{{clientPassword}}\"}" },
            "url": "{{baseUrl}}/api/auth/inscription"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 201', function () { pm.response.to.have.status(201); });", "if (pm.response.code === 201) pm.collectionVariables.set('tokenClient', pm.response.json().token);"] } }]
        },
        {
          "name": "POST connexion client",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{clientEmail}}\",\"motDePasse\":\"{{clientPassword}}\"}" },
            "url": "{{baseUrl}}/api/auth/connexion"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "if (pm.response.code === 200 && pm.response.json().utilisateur.role === 'client') pm.collectionVariables.set('tokenClient', pm.response.json().token);"] } }]
        },
        {
          "name": "POST connexion administrateur",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{adminEmail}}\",\"motDePasse\":\"{{adminPassword}}\"}" },
            "url": "{{baseUrl}}/api/auth/connexion"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('HTTP 200', function () { pm.response.to.have.status(200); });", "if (pm.response.code === 200 && pm.response.json().utilisateur.role === 'admin') pm.collectionVariables.set('tokenAdmin', pm.response.json().token);"] } }]
        }
