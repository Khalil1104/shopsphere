<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tickets - ShopSphere</title>
</head>
<body data-page="tickets">
  <header>
    <h1>Tickets de support</h1>
    <nav><a href="/admin/reviews">Avis</a> | <a href="/admin/tickets">Tickets</a> | <a href="/admin/stats">Statistiques</a></nav>
  </header>
  <form id="tokenForm">
    <label for="token">Jeton administrateur</label>
    <input id="token" type="password" autocomplete="off" required>
    <button>Enregistrer le jeton</button>
  </form>
  <p id="message" role="status"></p>
  <form id="filters">
    <label>Recherche <input name="search" maxlength="100"></label>
    <label>Statut
      <select name="statut">
        <option value="">Tous</option>
        <option value="ouvert">Ouvert</option>
        <option value="en_cours">En cours</option>
        <option value="resolu">Résolu</option>
        <option value="ferme">Fermé</option>
      </select>
    </label>
    <label>Priorité
      <select name="priorite">
        <option value="">Toutes</option>
        <option value="basse">Basse</option>
        <option value="normale">Normale</option>
        <option value="haute">Haute</option>
      </select>
    </label>
    <button>Rechercher</button>
  </form>
  <table>
    <thead><tr><th>Sujet</th><th>Client</th><th>Priorité</th><th>Statut</th><th>Dernier message</th><th>Détail</th></tr></thead>
    <tbody id="rows"></tbody>
  </table>
  <button id="previous" type="button">Précédent</button>
  <span id="pagination"></span>
  <button id="next" type="button">Suivant</button>
  <script src="/admin.js" defer></script>
</body>
</html>
