<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Statistiques - ShopSphere</title>
</head>
<body data-page="stats">
  <header>
    <h1>Statistiques</h1>
    <nav><a href="/admin/reviews">Avis</a> | <a href="/admin/tickets">Tickets</a> | <a href="/admin/stats">Statistiques</a></nav>
  </header>
  <form id="tokenForm">
    <label for="token">Jeton administrateur</label>
    <input id="token" type="password" autocomplete="off" required>
    <button>Enregistrer le jeton</button>
  </form>
  <p id="message" role="status"></p>
  <h2>Avis validés par produit</h2>
  <ul id="reviewStats"></ul>
  <h2>Tickets</h2>
  <p id="ticketStats"></p>
  <script src="/admin.js" defer></script>
</body>
</html>
