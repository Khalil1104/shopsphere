# --- Serveur ---
PORT=3001
APP_URL=http://localhost:3001

# --- MongoDB ---
MONGODB_URI=mongodb://127.0.0.1:27017/shopsphere_users

# --- JWT ---
# Secret long et aléatoire (au moins 32 caractères). Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=remplacez-moi-par-un-secret-tres-long-et-aleatoire
JWT_EXPIRES_IN=1d

# --- E-mails (Gmail : mot de passe d'application, pas votre vrai mot de passe) ---
# MAIL_TRANSPORT=smtp pour un envoi réel, json pour ne rien envoyer (tests)
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre.adresse@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=ShopSphere <votre.adresse@gmail.com>

# --- Durées de validité des liens ---
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_MINUTES=30

# --- Sécurité ---
# Nombre de mots de passe faux avant suspension automatique du compte
MAX_FAILED_LOGINS=5
# Nombre maximum de sessions (appareils connectés) par compte
MAX_SESSIONS=10
# Nombre max de requêtes d'authentification par IP toutes les 15 minutes
RATE_LIMIT_AUTH_MAX=50
